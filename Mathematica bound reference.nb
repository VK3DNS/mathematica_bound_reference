Cell[CellGroupData[{

Cell["TP form", "Subsection",
 CellChangeTimes->{{3.886601076526033*^9, 3.8866010899179993`*^9}, {
  3.894044164947851*^9, 
  3.894044169850576*^9}},ExpressionUUID->"4ffb8304-dab2-4270-b738-\
3ed9a10b2030"],

Cell[BoxData[
 RowBox[{
  RowBox[{"compsq", "[", 
   RowBox[{"a_", ",", "b_", ",", "c_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{"a", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"x", "+", 
        FractionBox["b", 
         RowBox[{"2", " ", "a"}]]}], ")"}], "2"]}], "-", 
    FractionBox[
     RowBox[{
      SuperscriptBox["b", "2"], "-", 
      RowBox[{"4", "a", " ", "c"}]}], 
     RowBox[{"4", "a"}]]}], "//", "TraditionalForm", " ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"copy", "-", 
      RowBox[{
      "paste", " ", "into", " ", "exam", " ", "and", " ", "enter", " ", 
       "a"}]}], ",", " ", 
     RowBox[{"b", " ", "and", " ", "c"}]}], "*)"}]}]}]], "Input",
 CellChangeTimes->{{3.894044177237207*^9, 3.894044241702462*^9}, {
   3.89404427378013*^9, 3.894044328589744*^9}, {3.900092955079521*^9, 
