Cell[BoxData[
 RowBox[{"SolveAlways", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"6", 
      SuperscriptBox["x", "3"]}], "-", 
     RowBox[{"7", 
      SuperscriptBox["x", "2"]}], "-", "x", "+", "2"}], "==", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"x", "-", "1"}], ")"}], 
