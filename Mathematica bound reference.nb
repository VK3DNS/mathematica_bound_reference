 CellLabel->"In[18]:=",ExpressionUUID->"31cd2537-2f93-43da-a538-ab211f66d349"],

Cell[BoxData[
 FormBox[
  RowBox[{
   FractionBox["1", "4"], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", "4"}], "\[PlusMinus]", 
     RowBox[{"2", " ", 
      SqrtBox["10"]}]}], ")"}]}], TraditionalForm]], "Output",
 CellChangeTimes->{{3.900095097528709*^9, 3.900095147022784*^9}},
