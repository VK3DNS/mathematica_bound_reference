  3.9000950261819763`*^9}},ExpressionUUID->"3a3ca571-596d-4dc4-a510-\
97e5fcfd2864"],

Cell[BoxData[
 RowBox[{
  RowBox[{"quad", "[", 
   RowBox[{"a_", ",", "b_", ",", "c_"}], "]"}], ":=", 
  RowBox[{
   FractionBox[
    RowBox[{
     RowBox[{"-", "b"}], "\[PlusMinus]", 
     SqrtBox[
      RowBox[{
       SuperscriptBox["b", "2"], "-", 
       RowBox[{"4", "a", " ", "c"}]}]]}], 
    RowBox[{"2", "a"}]], "//", "TraditionalForm"}]}]], "Input",
 CellChangeTimes->{{3.900095028162979*^9, 3.900095150009368*^9}},
 CellLabel->"In[19]:=",ExpressionUUID->"c50da38a-eced-456a-9330-f1b7827f8053"],

