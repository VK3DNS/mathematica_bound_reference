Cell[CellGroupData[{

Cell["Binomial dist", "Subsection",
 CellChangeTimes->{{3.9638608770569153`*^9, 
  3.9638608889758167`*^9}},ExpressionUUID->"8fc0f756-7786-42e4-b26d-\
f2e44c4996f7"],

Cell[BoxData[
 RowBox[{"(*", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Expected", " ", "vaue"}], " ", "=", " ", 
   RowBox[{
    RowBox[{"n", "*", "p", "\[IndentingNewLine]", "Variance"}], " ", "=", " ", 
    RowBox[{
     RowBox[{"n", "*", "p", "*", "q"}], "=", 
     RowBox[{
      RowBox[{"n", "*", "p", "*", 
       RowBox[{"(", 
        RowBox[{"1", "-", "p"}], ")"}], "\[IndentingNewLine]", 
       RowBox[{"Standard", " ", "deviation"}]}], "=", 
      RowBox[{
       SqrtBox["Variance"], "=", 
       RowBox[{
        SqrtBox[
         RowBox[{"n", "*", "p", "*", "q"}]], "=", 
        RowBox[{
         RowBox[{
          SqrtBox[
           RowBox[{"n", "*", "p", "*", 
            RowBox[{"(", 
             RowBox[{"1", "-", "p"}], ")"}]}]], "\[IndentingNewLine]", 
          "where", "\[IndentingNewLine]", "n"}], "=", 
         RowBox[{
          RowBox[{"#", " ", "trials", "\[IndentingNewLine]", "p"}], "=", 
          RowBox[{
           RowBox[{"probability", 
            RowBox[{"(", "success", ")"}], "\[IndentingNewLine]", "q"}], "=", 
           
           RowBox[{
            RowBox[{"probability", 
             RowBox[{"(", "failure", ")"}]}], "=", 
            RowBox[{"(", 
             RowBox[{"1", "-", "p"}], ")"}]}]}]}]}]}]}]}]}]}]}], 
  "\[IndentingNewLine]", "*)"}]], "Input",
 CellChangeTimes->{{3.963860883610593*^9, 
  3.963861023849902*^9}},ExpressionUUID->"a9a25b3e-615f-49ae-b688-\
1776640e6c1c"],

