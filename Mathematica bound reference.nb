  3.898881951351688*^9}},ExpressionUUID->"c2f18f71-9c5c-49fd-a3d9-\
405cad70b383"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Pr", 
    RowBox[{"(", 
     RowBox[{"A", " ", "\[Union]", " ", "B"}], ")"}]}], " ", "=", " ", 
   RowBox[{
    RowBox[{"Pr", 
     RowBox[{"(", "A", ")"}]}], " ", "+", " ", 
    RowBox[{"Pr", 
     RowBox[{"(", "B", ")"}]}], " ", "-", " ", 
    RowBox[{"Pr", 
     RowBox[{"(", 
      RowBox[{"A", " ", "\[Intersection]", " ", "B"}], ")"}]}]}]}], " ", 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Inderpendent", " ", "if", " ", "Pr", 
    RowBox[{"(", 
     RowBox[{"A", "\[Intersection]", "B"}], ")"}]}], " ", "=", " ", 
   RowBox[{"Pr", 
    RowBox[{"(", "A", ")"}], "*", "Pr", 
    RowBox[{"(", "B", ")"}]}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Pr", 
    RowBox[{"(", 
     RowBox[{"A", "\\", "B"}], ")"}]}], " ", "=", " ", 
   FractionBox[
    RowBox[{"Pr", 
     RowBox[{"(", 
      RowBox[{"A", "\[Intersection]", "B"}], ")"}]}], 
    RowBox[{"Pr", 
     RowBox[{"(", "B", ")"}]}]]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Pr", 
   RowBox[{"(", 
    RowBox[{"B", "\\", "A"}], ")"}]}], " ", "=", " ", 
  FractionBox[
   RowBox[{"Pr", 
    RowBox[{"(", 
     RowBox[{"A", "\[Intersection]", "B"}], ")"}]}], 
   RowBox[{"Pr", 
    RowBox[{"(", "A", ")"}]}]], " "}]}], "Input",
 CellChangeTimes->{{3.898881956046485*^9, 3.89888202243357*^9}, {
   3.8988821093435993`*^9, 3.898882168883225*^9}, {3.898882212847762*^9, 
   3.898882214973625*^9}, {3.8988837709567204`*^9, 3.898883855644906*^9}, 
   3.8988840897387133`*^9},ExpressionUUID->"e68f9d13-2a47-4ec3-a5a3-\
913d9aefdea6"]
